    "@angular/platform-browser-dynamic": "22.1.7",
    "@angular/router": "22.1.7",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "8.5.3",
